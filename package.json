{
  "name": "midnight-doctor",
  "version": "0.2.0",
  "description": "Pre-flight check for Midnight Network projects — catches version mismatches, duplicate ledgers, broken configs before they cost you hours of silent debugging.",
  "type": "module",
  "bin": {
    "midnight-doctor": "bin/midnight-doctor.js"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./matrix": "./data/compatibility-matrix.json"
  },
  "files": [
    "bin/",
    "lib/",
    "data/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test 'test/*.test.js'",
    "doctor": "node bin/midnight-doctor.js",
    "doctor:json": "node bin/midnight-doctor.js --json"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "midnight",
    "midnight-network",
    "zk",
    "zero-knowledge",
    "doctor",
    "preflight",
    "compatibility",
    "developer-tools",
    "cli"
  ],
  "author": "Frederico Santana <frederico@dpo2u.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fredericosanntana/midnight-doctor.git"
  },
  "bugs": {
    "url": "https://github.com/fredericosanntana/midnight-doctor/issues"
  }
}
